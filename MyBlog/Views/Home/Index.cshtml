@model MyBlog.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 bg-dark text-white rounded-3">
    <h1 class="display-5 fw-bold">Welcome to MyBlog</h1>
    <p class="fs-5">Articles about technology, programming, travel, health and food.</p>
    <a asp-controller="Posts" asp-action="Index" class="btn btn-warning btn-lg">View All Posts</a>
</div>

<div class="row">
    <div class="col-lg-9">
        <h2 class="mb-3">Latest Posts</h2>

        @if (!Model.LatestPosts.Any())
        {
            <div class="alert alert-info">No posts yet.</div>
        }

        <div class="row">
            @foreach (var post in Model.LatestPosts)
            {
                <div class="col-md-6 col-xl-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(post.ImagePath))
                        {
                            <img src="@post.ImagePath" class="card-img-top" alt="@post.Title"
                                 style="height:180px; object-fit:cover;" />
                        }
                        <div class="card-body">
                            <span class="badge bg-secondary mb-2">@post.Category.Name</span>
                            <h5 class="card-title">@post.Title</h5>
                            <div class="mb-2">
                                @foreach (var tag in post.Tags.Take(3))
                                {
                                    <a asp-controller="Posts" asp-action="Index" asp-route-tagId="@tag.Id"
                                       class="badge bg-light text-dark border text-decoration-none">#@tag.Name</a>
                                }
                            </div>
                            <p class="card-text text-muted">
                                @(post.Content.Length > 100 ? post.Content.Substring(0, 100) + "..." : post.Content)
                            </p>
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                            <small class="text-muted">@post.CreatedAt.ToString("yyyy/MM/dd")</small>
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id"
                               class="btn btn-sm btn-info">Read more</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-3">
        <h2 class="mb-3">Categories</h2>
        <ul class="list-group shadow-sm">
            @foreach (var c in Model.Categories)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a asp-controller="Posts" asp-action="Index" asp-route-categoryId="@c.Id"
                       class="text-decoration-none text-dark">@c.Name</a>
                    <span class="badge bg-secondary rounded-pill">@c.PostsCount</span>
                </li>
            }
        </ul>
    </div>
</div>