@model Category

@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Category</h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

@if (Model.Posts.Any())
{
    <div class="alert alert-warning">
        This category has <strong>@Model.Posts.Count</strong> post(s) and cannot be deleted.
    </div>
}
else
{
    <h3 class="text-danger">Are you sure you want to delete this category?</h3>
}

<div>
    <h4>@Model.Name</h4>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger" disabled="@Model.Posts.Any()">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>