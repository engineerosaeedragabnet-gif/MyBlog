@model MyBlog.ViewModels.PostListViewModel

@{
    ViewData["Title"] = "Posts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Posts</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Post</a>
</div>

<!-- Search & Filter -->
<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="searchTerm" value="@Model.SearchTerm"
               class="form-control" placeholder="Search posts..." />
    </div>

    <div class="col-md-3">
        <select name="categoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">All Categories</option>
        </select>
    </div>

    <div class="col-md-3">
        <select name="sortOrder" class="form-select">
            <option value="newest" selected="@(Model.SortOrder == "newest")">Newest</option>
            <option value="oldest" selected="@(Model.SortOrder == "oldest")">Oldest</option>
            <option value="title" selected="@(Model.SortOrder == "title")">Title (A-Z)</option>
        </select>
    </div>

    @if (Model.TagId.HasValue)
    {
        <input type="hidden" name="tagId" value="@Model.TagId" />
    }

    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-dark">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<!-- Active tag filter -->
@if (Model.TagId.HasValue)
{
    <div class="alert alert-secondary d-flex justify-content-between align-items-center">
        <span>Filtered by tag: <strong>#@ViewBag.ActiveTagName</strong></span>
        <a asp-action="Index" class="btn btn-sm btn-outline-dark">Clear</a>
    </div>
}

<!-- Results count -->
@if (Model.TotalItems > 0)
{
    <p class="text-muted">Showing @Model.Posts.Count of @Model.TotalItems posts</p>
}

<!-- Empty states -->
@if (!Model.Posts.Any())
{
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.CategoryId.HasValue || Model.TagId.HasValue)
    {
        <div class="alert alert-warning">
            No posts found@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : $" for \"{Model.SearchTerm}\"").
        </div>
    }
    else
    {
        <div class="alert alert-info">No posts yet.</div>
    }
}

<!-- Cards -->
<div class="row">
    @foreach (var post in Model.Posts)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(post.ImagePath))
                {
                    <img src="@post.ImagePath" class="card-img-top" alt="@post.Title"
                         style="height:200px; object-fit:cover;" />
                }
                <div class="card-body">
                    <span class="badge bg-secondary mb-2">@post.Category.Name</span>
                    <h5 class="card-title">@post.Title</h5>

                    <div class="mb-2">
                        @foreach (var tag in post.Tags.Take(3))
                        {
                            <a asp-action="Index" asp-route-tagId="@tag.Id"
                               class="badge bg-light text-dark border text-decoration-none">#@tag.Name</a>
                        }
                    </div>

                    <p class="card-text text-muted">
                        @(post.Content.Length > 150 ? post.Content.Substring(0, 150) + "..." : post.Content)
                    </p>
                </div>
                <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                    <small class="text-muted">@post.CreatedAt.ToString("yyyy/MM/dd")</small>
                    <div>
                        <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-info">Read more</a>
                        <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@post.Id" class="btn btn-sm btn-danger">Delete</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Posts pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-tagId="@Model.TagId"
                   asp-route-sortOrder="@Model.SortOrder">Previous</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-tagId="@Model.TagId"
                       asp-route-sortOrder="@Model.SortOrder">@i</a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-tagId="@Model.TagId"
                   asp-route-sortOrder="@Model.SortOrder">Next</a>
            </li>
        </ul>
    </nav>
}