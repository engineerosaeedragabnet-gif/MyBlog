@model Post

@{
    ViewData["Title"] = "Delete Post";
}

<h1>Delete Post</h1>
<h3 class="text-danger">Are you sure you want to delete this post?</h3>

<div class="card mb-3">
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="@Model.ImagePath" class="card-img-top" style="max-height:250px; object-fit:cover;" />
    }
    <div class="card-body">
        <h4>@Model.Title</h4>
        <span class="badge bg-secondary">@Model.Category.Name</span>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form> 